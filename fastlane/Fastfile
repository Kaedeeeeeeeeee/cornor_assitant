default_platform(:mac)

APP_IDENTIFIER = "com.shifeng.peek"
APP_STORE_ID = 6785167787
TEAM_ID = "Y4FV6WUU4V"

def corner_peek_api_key
  key_id = ENV["ASC_KEY_ID"]
  issuer_id = ENV["ASC_ISSUER_ID"]
  key_path = ENV["ASC_KEY_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  key_content = ENV["ASC_KEY_CONTENT"] || ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

  UI.user_error!("Set ASC_KEY_ID in .env.asc or the shell environment") if key_id.to_s.empty?
  UI.user_error!("Set ASC_ISSUER_ID in .env.asc or the shell environment") if issuer_id.to_s.empty?

  options = {
    key_id: key_id,
    issuer_id: issuer_id,
    duration: 1200,
    in_house: false
  }

  if !key_content.to_s.empty?
    options[:key_content] = key_content
    options[:is_key_content_base64] = ENV["ASC_KEY_CONTENT_BASE64"] == "1"
  elsif !key_path.to_s.empty?
    options[:key_filepath] = File.expand_path(key_path)
  else
    UI.user_error!("Set ASC_KEY_PATH or ASC_KEY_CONTENT for the App Store Connect API key")
  end

  app_store_connect_api_key(**options)
end

platform :mac do
  desc "Generate fastlane metadata and screenshot folders from repository sources"
  lane :prepare_app_store_assets do
    sh("../script/prepare_fastlane_metadata.sh")
    sh("../script/prepare_fastlane_screenshots.sh")
  end

  desc "Upload generated App Store screenshots without touching metadata or binary"
  lane :upload_screenshots do
    corner_peek_api_key
    sh("../script/prepare_fastlane_screenshots.sh")
    sh("../script/upload_fastlane_screenshots_direct.rb")
  end

  desc "Upload generated App Store metadata without touching screenshots or binary"
  lane :upload_metadata do
    api_key = corner_peek_api_key
    sh("../script/prepare_fastlane_metadata.sh")

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app: APP_STORE_ID,
      team_id: TEAM_ID,
      platform: "osx",
      metadata_path: "./metadata",
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Upload generated App Store metadata and screenshots without touching binary"
  lane :upload_app_store_assets do
    api_key = corner_peek_api_key
    sh("../script/prepare_fastlane_metadata.sh")
    sh("../script/prepare_fastlane_screenshots.sh")

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app: APP_STORE_ID,
      team_id: TEAM_ID,
      platform: "osx",
      metadata_path: "./metadata",
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )

    sh("../script/upload_fastlane_screenshots_direct.rb")
  end

  desc "Upload a signed macOS pkg to App Store Connect"
  lane :upload_pkg do |options|
    api_key = corner_peek_api_key
    pkg_path = options[:pkg] || ENV["ASC_PKG_PATH"]
    UI.user_error!("Pass pkg:/path/to/App.pkg or set ASC_PKG_PATH") if pkg_path.to_s.empty?

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app: APP_STORE_ID,
      team_id: TEAM_ID,
      platform: "osx",
      pkg: File.expand_path(pkg_path),
      skip_binary_upload: false,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
