# Copy this file to .env.asc and fill in values from App Store Connect.
# Do not commit .env.asc or the .p8 key file.

ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Optional: use base64 key content instead of ASC_KEY_PATH, useful for CI.
# ASC_KEY_CONTENT=
# ASC_KEY_CONTENT_BASE64=1
